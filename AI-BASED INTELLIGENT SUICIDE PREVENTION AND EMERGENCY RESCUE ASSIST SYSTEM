    # --------------------------------------------------------------------------
    # Telemetry Ingestion & Periodic UI Updates
    # --------------------------------------------------------------------------
    def _on_packet_received_thread(self, packet):
        w = packet["weight"]
        d = packet["distance"]
        ax = packet["accel_x"]
        st = packet["status"]

        eval_res = RakshaEvaluator.evaluate(w, d, ax, st)

        with self.data_lock:
            self.latest_packet = packet
            self.latest_eval = eval_res

            self.stats["total_packets"] += 1
            diag = eval_res["diagnosis"]
            if diag == "NORMAL":
                self.stats["normal"] += 1
            elif diag == "PERSON_DETECT":
                self.stats["person_detect"] += 1
            elif diag == "FAN_ABNORMAL":
                self.stats["fan_abnormal"] += 1
            elif diag == "SUICIDE_ATTEMPT":
                self.stats["SUICIDE_ATTEMPT"] += 1

    def _periodic_gui_tick(self):
        """Dispatched in Tkinter UI thread to update the cards, banner, and charts."""
        with self.data_lock:
            pkt = self.latest_packet
            res = self.latest_eval
            self.latest_packet = None  # Consume

        if pkt and res:
            self._update_cards(pkt, res)
            self._update_abnormal_breakdown(res)
            self._update_charts(pkt)
            self._update_bottom_readout(pkt, res)

        self.after(200, self._periodic_gui_tick)

    def _update_cards(self, pkt, res):
        w = pkt["weight"]
        d = pkt["distance"]
        ax = pkt["accel_x"]
        st = pkt["status"]

        # ----------------------------------------------------------------------
        # Card 1: Weight
        # ----------------------------------------------------------------------
        self.card_weight["val_lbl"].configure(text=f"{w:.1f} units")
        gauge_w = min(1.0, max(0.0, w / self.card_weight["max_gauge"]))
        self.card_weight["pbar"].set(gauge_w)

        if res["is_weight_abnormal"]:
            # Red Highlight
            self.card_weight["frame"].configure(border_color=COLOR_DANGER, border_width=2)
            self.card_weight["val_lbl"].configure(text_color=COLOR_DANGER)
            self.card_weight["status_pill"].configure(
                text="ABNORMAL (>1000)", text_color="#ffffff", fg_color=COLOR_DANGER
            )
            self.card_weight["pbar"].configure(progress_color=COLOR_DANGER)
            self.card_weight["detail_lbl"].configure(
                text="EXCESS LOAD / PULL (>1000)", text_color=COLOR_DANGER
            )
        else:
            # Normal Green
            self.card_weight["frame"].configure(border_color=COLOR_CARD_BORDER, border_width=1)
            self.card_weight["val_lbl"].configure(text_color=COLOR_TEXT)
            self.card_weight["status_pill"].configure(
                text="NORMAL", text_color=COLOR_NORMAL, fg_color="#0f172a"
            )
            self.card_weight["pbar"].configure(progress_color=COLOR_NORMAL)
            self.card_weight["detail_lbl"].configure(
                text="STATUS: NORMAL (<=1000)", text_color=COLOR_NORMAL
            )

        # ----------------------------------------------------------------------
        # Card 2: Distance
        # ----------------------------------------------------------------------
        self.card_distance["val_lbl"].configure(text=f"{d:.1f} cm")
        gauge_d = min(1.0, max(0.0, d / self.card_distance["max_gauge"]))
        self.card_distance["pbar"].set(gauge_d)

        if res["is_distance_abnormal"]:
            # Amber/Red Highlight
            badge_color = COLOR_DANGER if res["is_weight_abnormal"] else COLOR_WARN
            self.card_distance["frame"].configure(border_color=badge_color, border_width=2)
            self.card_distance["val_lbl"].configure(text_color=badge_color)
            self.card_distance["status_pill"].configure(
                text="ABNORMAL (<20cm)", text_color="#ffffff", fg_color=badge_color
            )
            self.card_distance["pbar"].configure(progress_color=badge_color)
            self.card_distance["detail_lbl"].configure(
                text="PROXIMITY DETECTED (<20cm)", text_color=badge_color
            )
        else:
            # Normal Green
            self.card_distance["frame"].configure(border_color=COLOR_CARD_BORDER, border_width=1)
            self.card_distance["val_lbl"].configure(text_color=COLOR_TEXT)
            self.card_distance["status_pill"].configure(
                text="NORMAL", text_color=COLOR_NORMAL, fg_color="#0f172a"
            )
            self.card_distance["pbar"].configure(progress_color=COLOR_NORMAL)
            self.card_distance["detail_lbl"].configure(
                text="STATUS: SAFE (>=20cm)", text_color=COLOR_NORMAL
            )

        # ----------------------------------------------------------------------
        # Card 3: Accelerometer X
        # ----------------------------------------------------------------------
        self.card_accel["val_lbl"].configure(text=f"{ax:+.2f} m/s²")
        gauge_ax = min(1.0, max(0.0, abs(ax) / self.card_accel["max_gauge"]))
        self.card_accel["pbar"].set(gauge_ax)

        if res["is_accel_abnormal"]:
            # Red Highlight
            self.card_accel["frame"].configure(border_color=COLOR_DANGER, border_width=2)
            self.card_accel["val_lbl"].configure(text_color=COLOR_DANGER)
            self.card_accel["status_pill"].configure(
                text="ABNORMAL (|X|>7)", text_color="#ffffff", fg_color=COLOR_DANGER
            )
            self.card_accel["pbar"].configure(progress_color=COLOR_DANGER)
            self.card_accel["detail_lbl"].configure(
                text="EXCESS VIBRATION / TILT", text_color=COLOR_DANGER
            )
        else:
            # Normal Green
            self.card_accel["frame"].configure(border_color=COLOR_CARD_BORDER, border_width=1)
            self.card_accel["val_lbl"].configure(text_color=COLOR_TEXT)
            self.card_accel["status_pill"].configure(
                text="NORMAL", text_color=COLOR_NORMAL, fg_color="#0f172a"
            )
            self.card_accel["pbar"].configure(progress_color=COLOR_NORMAL)
            self.card_accel["detail_lbl"].configure(
                text="STATUS: STABLE (±7 m/s²)", text_color=COLOR_NORMAL
            )

        # ----------------------------------------------------------------------
        # Card 4: Status
        # ----------------------------------------------------------------------
        diag = res["diagnosis"]
        diag_color = res["color"]
        self.card_status["rx_pill"].configure(text=f"RX: {st}")
        self.card_status["val_lbl"].configure(text=diag, text_color=diag_color)

        if res["has_abnormal"]:
            self.card_status["frame"].configure(border_color=diag_color, border_width=2)
            self.card_status["pbar"].configure(progress_color=diag_color)
            if diag == "SUICIDE_ATTEMPT":
                self.card_status["pbar"].set(0.15)
                self.card_status["detail_lbl"].configure(text="CRITICAL: ATTEMPT DETECTED", text_color=COLOR_DANGER)
                self.card_status["mode_lbl"].configure(text="EMERGENCY CUTOFF")
            elif diag == "FAN_ABNORMAL":
                self.card_status["pbar"].set(0.40)
                self.card_status["detail_lbl"].configure(text="WARNING: WOBBLE FAULT", text_color=COLOR_DANGER)
                self.card_status["mode_lbl"].configure(text="MAINTENANCE REQ")
            elif diag == "PERSON_DETECT":
                self.card_status["pbar"].set(0.70)
                self.card_status["detail_lbl"].configure(text="CAUTION: PERSON DETECTED", text_color=COLOR_WARN)
                self.card_status["mode_lbl"].configure(text="PROXIMITY ACTIVE")
        else:
            self.card_status["frame"].configure(border_color=COLOR_CARD_BORDER, border_width=1)
            self.card_status["pbar"].configure(progress_color=COLOR_NORMAL)
            self.card_status["pbar"].set(1.0)
            self.card_status["detail_lbl"].configure(text="SYSTEM HEALTH: 100%", text_color=COLOR_NORMAL)
            self.card_status["mode_lbl"].configure(text="SAFE OPERATIONAL")

    def _update_abnormal_breakdown(self, res):
        """Highlights explicitly which values are abnormal."""
        if res["has_abnormal"]:
            # One or more parameters abnormal
            self.diag_panel.configure(
                border_color=res["color"],
                border_width=2,
                fg_color="#18181b"
            )
            self.diag_headline.configure(
                text=f"🚨 {res['headline']}",
                text_color=res["color"]
            )
            self.diag_severity_badge.configure(
                text=f"ALERT: {res['severity']}",
                fg_color=res["color"],
                text_color="#ffffff"
            )

            # Build human-readable breakdown of WHICH values are abnormal
            abnormal_items = []
            for item in res["abnormalities"]:
                abnormal_items.append(f"• [{item['param'].upper()} ABNORMAL]: Value is {item['current']} (Violates {item['limit']}) — {item['reason']}")

            breakdown_text = "\n".join(abnormal_items)
            self.abnormal_breakdown_label.configure(
                text=breakdown_text,
                text_color="#fecdd3" if res["severity"] == "CRITICAL" else "#fef08a"
            )
            self.diag_action_label.configure(
                text=f"Directive: {res['action']}",
                text_color=res["color"]
            )
        else:
            # Everything normal
            self.diag_panel.configure(
                border_color=COLOR_NORMAL,
                border_width=1,
                fg_color=COLOR_CARD
            )
            self.diag_headline.configure(
                text="✔ ALL SENSORS WITHIN SAFE OPERATING THRESHOLDS",
                text_color=COLOR_NORMAL
            )
            self.diag_severity_badge.configure(
                text="STATUS: NORMAL & SAFE",
                fg_color=COLOR_NORMAL,
                text_color="#ffffff"
            )
            self.abnormal_breakdown_label.configure(
                text="No abnormal values detected. Weight <= 1000 units, Distance >= 20 cm, and Accelerometer X within ±7 m/s².",
                text_color=COLOR_TEXT_MUTED
            )
            self.diag_action_label.configure(
                text="System status: Safe operational mode. Continuous sensor monitoring active.",
                text_color=COLOR_NORMAL
            )

    def _update_charts(self, pkt):
        self.chart_weight.add_point(pkt["weight"])
        self.chart_distance.add_point(pkt["distance"])
        self.chart_accel.add_point(pkt["accel_x"])

    def _update_bottom_readout(self, pkt, res):
        ts = pkt["timestamp"]
        raw = pkt["raw"]
        diag = res["diagnosis"]
        abnormal_names = [a["param"] for a in res["abnormalities"]]
        abnormal_str = f"ABNORMAL: {', '.join(abnormal_names)}" if abnormal_names else "ALL NORMAL"

        color = res["color"]
        self.latest_raw_label.configure(
            text=f"[{ts}] RAW: \"{raw}\"  ➔  [{abnormal_str}]  ➔  DIAGNOSIS: {diag}",
            text_color=color
        )

        s = self.stats
        self.stats_lbl.configure(
            text=f"Total: {s['total_packets']}  |  Normal: {s['normal']}  |  Person Detect: {s['person_detect']}  |  Fan Wobble: {s['fan_abnormal']}  |  SD Attempt: {s['SUICIDE_ATTEMPT']}"
        )

    # --------------------------------------------------------------------------
    # Thread Callbacks & Logging
    # --------------------------------------------------------------------------
    def _on_log_thread(self, message, level="INFO"):
        self.after(0, self._append_log, message, level)

    def _append_log(self, message, level="INFO"):
        ts = datetime.datetime.now().strftime("%H:%M:%S")
        print(f"[{ts}] [{level}] {message}")

    def _on_state_change_thread(self, is_active, status_text):
        self.after(0, self._update_connection_state_ui, is_active, status_text)

    def _update_connection_state_ui(self, is_active, status_text):
        if is_active:
            self.status_badge.configure(
                text=f"● {status_text.upper()}",
                text_color="#ffffff",
                fg_color=COLOR_NORMAL if "Simulation" in status_text else "#2563eb"
            )
        else:
            self.status_badge.configure(
                text="● SYSTEM DISCONNECTED",
                text_color=COLOR_TEXT_MUTED,
                fg_color="#334155"
            )

    # --------------------------------------------------------------------------
    # User Action Handlers
    # --------------------------------------------------------------------------
    def _refresh_ports(self):
        ports = SerialManager.get_available_ports()
        self.port_combo.configure(values=ports)
        if ports:
            self.port_combo.set(ports[0])
        self._append_log(f"Refreshed serial ports list: {ports}", "INFO")

    def _toggle_connection(self):
        if self.serial_manager.is_connected:
            self.serial_manager.disconnect()
            self.connect_btn.configure(text="🔌 Connect Arduino", fg_color="#2563eb")
        else:
            port = self.port_combo.get()
            if not port or "No Ports" in port or "No Serial" in port:
                messagebox.showwarning(
                    "Port Selection",
                    "No valid serial port found.\nPlease plug in your Arduino hardware or click 'Start Simulation' for the Virtual Fan Demo!"
                )
                return
            baud = int(self.baud_combo.get())
            success, msg = self.serial_manager.connect(port, baud)
            if success:
                self.connect_btn.configure(text="⏹ Disconnect", fg_color="#dc2626")
                if self.serial_manager.is_simulating:
                    self.sim_btn.configure(text="▶ Start Simulation", fg_color="#059669")
            else:
                messagebox.showerror("Connection Failed", f"Could not open serial port {port}:\n{msg}")

    def _toggle_simulation(self):
        if self.serial_manager.is_simulating:
            self.serial_manager.stop_simulation()
            self.sim_btn.configure(text="▶ Start Simulation", fg_color="#059669")
        else:
            mode = self.sim_combo.get()
            self.serial_manager.start_simulation(mode)
            self.sim_btn.configure(text="⏹ Stop Simulation", fg_color="#dc2626")
            if self.serial_manager.is_connected:
                self.connect_btn.configure(text="🔌 Connect Arduino", fg_color="#2563eb")

    def _on_sim_mode_changed(self, mode_name):
        self.serial_manager.set_simulation_mode(mode_name)

    def _reset_stats(self):
        for k in self.stats:
            self.stats[k] = 0
        s = self.stats
        self.stats_lbl.configure(
            text=f"Total: 0  |  Normal: 0  |  Person Detect: 0  |  Fan Wobble: 0  |  SD Attempt: 0"
        )
        self._append_log("Telemetry counters reset.", "INFO")

    def _on_close(self):
        self.serial_manager.disconnect()
        self.destroy()


def main():
    app = RakshaFanApp()
    app.mainloop()


if __name__ == "__main__":
    main()
