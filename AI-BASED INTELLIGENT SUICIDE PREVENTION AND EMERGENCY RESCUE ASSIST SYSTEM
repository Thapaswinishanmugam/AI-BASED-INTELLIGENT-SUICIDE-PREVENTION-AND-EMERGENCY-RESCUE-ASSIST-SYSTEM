# ==============================================================================
# Evaluator & Logic Engine
# ==============================================================================
class RakshaEvaluator:
    """
    Evaluates sensor telemetry for the RakshaFan system according to Arduino thresholds:
      - Distance < 20 cm                 -> PERSON_DETECT
      - Accelerometer X > 7 or < -7      -> FAN_ABNORMAL
      - Units (Weight) > 1000 & Dist < 20 -> SUICIDE_ATTEMPT
      - Otherwise                        -> NORMAL
    Also detects and lists WHICH individual parameters are abnormal.
    """
    WEIGHT_THRESHOLD = 1000.0     # units (grams/load threshold)
    DISTANCE_THRESHOLD = 20.0    # cm
    ACCEL_X_THRESHOLD = 7.0      # m/s^2 (safe range [-7, 7])

    @classmethod
    def evaluate(cls, weight: float, distance: float, accel_x: float, raw_status: str = ""):
        abnormalities = []

        # 1. Check Weight
        is_weight_abnormal = weight > cls.WEIGHT_THRESHOLD
        if is_weight_abnormal:
            abnormalities.append({
                "param": "Weight",
                "current": f"{weight:.1f} units",
                "limit": f"> {cls.WEIGHT_THRESHOLD:.0f} units",
                "reason": f"Excessive load ({weight:.1f} > {cls.WEIGHT_THRESHOLD:.0f} units) detected on fan rod/blades"
            })

        # 2. Check Distance
        is_distance_abnormal = distance < cls.DISTANCE_THRESHOLD
        if is_distance_abnormal:
            abnormalities.append({
                "param": "Distance",
                "current": f"{distance:.1f} cm",
                "limit": f"< {cls.DISTANCE_THRESHOLD:.0f} cm",
                "reason": f"Person or obstacle within close proximity ({distance:.1f} < {cls.DISTANCE_THRESHOLD:.0f} cm)"
            })

        # 3. Check Accelerometer X
        is_accel_abnormal = (accel_x > cls.ACCEL_X_THRESHOLD) or (accel_x < -cls.ACCEL_X_THRESHOLD)
        if is_accel_abnormal:
            abnormalities.append({
                "param": "Accelerometer X",
                "current": f"{accel_x:+.2f} m/s²",
                "limit": f"|X| > {cls.ACCEL_X_THRESHOLD:.1f} m/s²",
                "reason": f"Severe vibration / wobble ({accel_x:+.2f} m/s² exceeds safe band ±{cls.ACCEL_X_THRESHOLD:.1f})"
            })

        # Overall System Diagnosis & Priority:
        # Suicide / Sudden-Drop Attempt takes highest priority
        if is_weight_abnormal and is_distance_abnormal:
            diagnosis = "SUICIDE_ATTEMPT"
            severity = "CRITICAL"
            headline = "CRITICAL: SUICIDE / SUDDEN DROP ATTEMPT DETECTED!"
            color = COLOR_DANGER
            action = "EMERGENCY: Cutting fan power relay & sounding audible alarm buzzer immediately!"
        elif is_weight_abnormal:
            diagnosis = "SUICIDE_ATTEMPT"
            severity = "CRITICAL"
            headline = "CRITICAL: EXTREME DOWNWARD LOAD DETECTED ON FAN!"
            color = COLOR_DANGER
            action = "EMERGENCY: Weight exceeds 1000 units safety limit. Fan motor shutdown triggered!"
        elif is_accel_abnormal:
            diagnosis = "FAN_ABNORMAL"
            severity = "WARNING"
            headline = "WARNING: ABNORMAL FAN WOBBLE / BLADE IMBALANCE!"
            color = COLOR_DANGER
            action = "MAINTENANCE: High vibration detected. Inspect fan mounting, downrod, and blade balance!"
        elif is_distance_abnormal:
            diagnosis = "PERSON_DETECT"
            severity = "CAUTION"
            headline = "CAUTION: PERSON DETECTED IN PROXIMITY UNDER FAN"
            color = COLOR_WARN
            action = "SAFETY: Proximity sensor triggered (< 20 cm). Monitoring for load or movement changes."
        else:
            diagnosis = "NORMAL"
            severity = "NORMAL"
            headline = "ALL SENSORS NORMAL & FAN OPERATING SAFELY"
            color = COLOR_NORMAL
            action = "System idle: Fan running under normal operating conditions."

        # If Arduino transmitted a specific recognized status, report it
        normalized_raw = raw_status.strip().upper()

        return {
            "weight": weight,
            "distance": distance,
            "accel_x": accel_x,
            "raw_status": raw_status,
            "is_weight_abnormal": is_weight_abnormal,
            "is_distance_abnormal": is_distance_abnormal,
            "is_accel_abnormal": is_accel_abnormal,
            "has_abnormal": len(abnormalities) > 0,
            "abnormalities": abnormalities,
            "diagnosis": diagnosis,
            "severity": severity,
            "headline": headline,
            "color": color,
            "action": action
        }


# ==============================================================================
# Serial Communication & Hardware Simulation Handler
# ==============================================================================
class SerialManager:
    """Manages real serial port communication and realistic virtual fan telemetry."""
    def __init__(self, on_packet_callback, on_log_callback, on_state_callback):
        self.on_packet = on_packet_callback
        self.on_log = on_log_callback
        self.on_state = on_state_callback

        self.serial_inst = None
        self.is_connected = False
        self.is_simulating = False
        self.sim_mode = "Auto Cycle"

        self._read_thread = None
        self._sim_thread = None
        self._stop_event = threading.Event()

    @staticmethod
    def get_available_ports():
        if not HAS_SERIAL:
            return ["No Serial Library"]
        ports = [p.device for p in serial.tools.list_ports.comports()]
        return ports if ports else ["No Ports Detected"]

    def connect(self, port: str, baud: int = 9600):
        if not HAS_SERIAL:
            return False, "pyserial library is not installed."
        if self.is_simulating:
            self.stop_simulation()

        try:
            self.serial_inst = serial.Serial(port, baud, timeout=1.0)
            self.is_connected = True
            self._stop_event.clear()
            self._read_thread = threading.Thread(target=self._serial_read_worker, daemon=True)
            self._read_thread.start()
            self.on_state(True, f"Connected to {port} @ {baud}")
            self.on_log(f"Successfully connected to serial port: {port} ({baud} baud)", "SUCCESS")
            return True, "Connected"
        except Exception as e:
            self.is_connected = False
            self.on_state(False, "Disconnected")
            return False, str(e)

    def disconnect(self):
        self._stop_event.set()
        if self.serial_inst and self.serial_inst.is_open:
            try:
                self.serial_inst.close()
            except Exception:
                pass
        self.is_connected = False
        self.is_simulating = False
        self.on_state(False, "Disconnected")
        self.on_log("Serial / Simulator stopped.", "INFO")

    def start_simulation(self, mode="Auto Cycle"):
        if self.is_connected:
            self.disconnect()

        self.sim_mode = mode
        self.is_simulating = True
        self._stop_event.clear()
        self._sim_thread = threading.Thread(target=self._sim_worker, daemon=True)
        self._sim_thread.start()
        self.on_state(True, f"Simulation: {mode}")
        self.on_log(f"Started hardware simulator in mode: {mode}", "INFO")

    def stop_simulation(self):
        self._stop_event.set()
        self.is_simulating = False
        self.on_state(False, "Disconnected")
        self.on_log("Simulator stopped.", "INFO")

    def set_simulation_mode(self, mode):
        self.sim_mode = mode
        if self.is_simulating:
            self.on_state(True, f"Simulation: {mode}")
            self.on_log(f"Simulation scenario switched to: {mode}", "INFO")

    def _serial_read_worker(self):
        buf = ""
        while not self._stop_event.is_set():
            try:
                if self.serial_inst and self.serial_inst.in_waiting:
                    raw_bytes = self.serial_inst.readline()
                    raw_line = raw_bytes.decode("utf-8", errors="replace").strip()
                    if raw_line:
                        self._process_incoming_line(raw_line)
                else:
                    time.sleep(0.02)
            except Exception as e:
                self.on_log(f"Serial read error: {e}", "ERROR")
                break
        self.is_connected = False
        self.on_state(False, "Disconnected")

    def _sim_worker(self):
        step = 0
        while not self._stop_event.is_set():
            mode = self.sim_mode
            if mode == "Auto Cycle":
                # Cycle every 8 seconds through different realistic states
                cycle_idx = (step // 16) % 4
                if cycle_idx == 0:
                    current_mode = "Normal"
                elif cycle_idx == 1:
                    current_mode = "Person Detect"
                elif cycle_idx == 2:
                    current_mode = "Fan Abnormal"
                else:
                    current_mode = "Suicide Attempt"
            else:
                current_mode = mode

            # Generate realistic sensor values based on scenario
            if current_mode in ("Normal", "Normal (Safe Operation)"):
                w = round(random.uniform(0.5, 5.0), 1)
                d = round(random.uniform(35.0, 65.0), 1)
                ax = round(random.uniform(-1.5, 1.5), 1)
                st = "NORMAL"
            elif current_mode in ("Person Detect", "Person Detected (< 20 cm)"):
                w = round(random.uniform(1.0, 4.0), 1)
                d = round(random.uniform(9.0, 18.5), 1)
                ax = round(random.uniform(-1.2, 1.2), 1)
                st = "PERSON_DETECT"
            elif current_mode in ("Fan Abnormal", "Fan Abnormal Wobble (|X| > 7)"):
                w = round(random.uniform(2.0, 8.0), 1)
                d = round(random.uniform(40.0, 60.0), 1)
                sign = random.choice([1, -1])
                ax = round(sign * random.uniform(7.8, 11.5), 1)
                st = "FAN_ABNORMAL"
            elif current_mode in ("Suicide Attempt", "Suicide Attempt (> 1000 & < 20)"):
                w = round(random.uniform(1150.0, 1650.0), 1)
                d = round(random.uniform(8.0, 17.0), 1)
                ax = round(random.uniform(-2.5, 3.5), 1)
                st = "SUICIDE_ATTEMPT"
            elif current_mode in ("Heavy Load Only", "Heavy Load Only (> 1000)"):
                w = round(random.uniform(1100.0, 1400.0), 1)
                d = round(random.uniform(35.0, 50.0), 1)
                ax = round(random.uniform(-1.0, 1.0), 1)
                st = "SUICIDE_ATTEMPT"
            else:
                w, d, ax, st = 2.0, 45.0, 0.5, "NORMAL"

            # Format matching Arduino: Weight,Distance,Accelerometerx,Status
            line = f"{w},{d},{ax},{st}"
            self._process_incoming_line(line)

            step += 1
            time.sleep(0.5)

    def _process_incoming_line(self, line: str):
        line = line.strip()
        if not line:
            return

        parts = [p.strip() for p in line.split(",")]
        if len(parts) >= 3:
            try:
                def clean_float(token):
                    # Clean out prefixes if Arduino sends something like "W:2"
                    if ":" in token:
                        token = token.split(":")[-1]
                    return float(token.strip())

                weight = clean_float(parts[0])
                distance = clean_float(parts[1])
                accel_x = clean_float(parts[2])
                status = parts[3].strip() if len(parts) > 3 else "NORMAL"

                parsed = {
                    "raw": line,
                    "weight": weight,
                    "distance": distance,
                    "accel_x": accel_x,
                    "status": status,
                    "timestamp": datetime.datetime.now().strftime("%H:%M:%S")
                }
                self.on_packet(parsed)
            except ValueError:
                self.on_log(f"Unrecognized serial format: '{line}'", "WARN")
        else:
            self.on_log(f"Raw Arduino message: {line}", "INFO")


