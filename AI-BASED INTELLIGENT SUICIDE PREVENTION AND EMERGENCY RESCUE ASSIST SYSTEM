# Native Tkinter Canvas Real-Time Strip Chart (Zero Matplotlib Dependency)
# ==============================================================================
class TkStripChart(tk.Canvas):
    """
    High-performance real-time strip chart rendered on native Tkinter Canvas.
    Supports dashed threshold lines, dynamic grid, current value tag, and smooth traces.
    """
    def __init__(self, parent, title="CHART", unit="", min_val=0, max_val=100,
                 line_color="#38bdf8", thresholds=None, height=150, **kwargs):
        super().__init__(
            parent,
            bg="#0f172a",
            highlightthickness=1,
            highlightbackground="#334155",
            height=height,
            **kwargs
        )
        self.title = title
        self.unit = unit
        self.min_val = min_val
        self.max_val = max_val
        self.line_color = line_color
        self.thresholds = thresholds or []  # List of tuples: (val, color, label)
        self.history = deque(maxlen=35)

        self.bind("<Configure>", lambda e: self.redraw())

    def add_point(self, val: float):
        self.history.append(val)
        self.redraw()

    def redraw(self):
        self.delete("all")
        w = self.winfo_width()
        h = self.winfo_height()
        if w <= 60 or h <= 40:
            w = max(w, 280)
            h = max(h, 140)

        pad_left, pad_right, pad_top, pad_bottom = 50, 16, 26, 20
        plot_w = max(20, w - pad_left - pad_right)
        plot_h = max(20, h - pad_top - pad_bottom)

        # Plot Title (Top Left)
        self.create_text(
            pad_left, 12,
            text=self.title,
            fill="#cbd5e1",
            font=("Helvetica", 10, "bold"),
            anchor="w"
        )

        current_vals = list(self.history)
        y_min = self.min_val
        y_max = self.max_val
        if current_vals:
            y_min = min(y_min, min(current_vals))
            y_max = max(y_max, max(current_vals))
        if y_max <= y_min:
            y_max = y_min + 1.0

        # Draw 3 Horizontal Grid Lines & Y-Axis Scale
        for frac in [0.0, 0.5, 1.0]:
            y_coord = pad_top + plot_h * (1.0 - frac)
            val = y_min + (y_max - y_min) * frac
            self.create_line(pad_left, y_coord, pad_left + plot_w, y_coord, fill="#1e293b", dash=(3, 3))
            self.create_text(
                pad_left - 6, y_coord,
                text=f"{val:.0f}",
                fill="#64748b",
                font=("Helvetica", 8),
                anchor="e"
            )

        # Draw Safety Threshold Reference Lines
        for th_val, th_col, th_lbl in self.thresholds:
            if y_min <= th_val <= y_max:
                norm_th = (th_val - y_min) / (y_max - y_min)
                y_coord = pad_top + plot_h * (1.0 - norm_th)
                self.create_line(
                    pad_left, y_coord, pad_left + plot_w, y_coord,
                    fill=th_col, dash=(4, 3), width=1
                )
                self.create_text(
                    pad_left + plot_w - 4, y_coord - 7,
                    text=th_lbl,
                    fill=th_col,
                    font=("Helvetica", 8, "bold"),
                    anchor="e"
                )

        # Draw Line Graph & Data Points
        if len(current_vals) >= 2:
            pts = []
            max_slots = self.history.maxlen - 1
            for i, val in enumerate(current_vals):
                x = pad_left + (i / max(1, max_slots)) * plot_w
                norm_y = (val - y_min) / (y_max - y_min)
                y = pad_top + plot_h * (1.0 - norm_y)
                pts.extend([x, y])

            # Draw trace line
            self.create_line(*pts, fill=self.line_color, width=2)

            # Draw point dots
            for i in range(0, len(pts), 2):
                px, py = pts[i], pts[i + 1]
                self.create_oval(px - 2, py - 2, px + 2, py + 2, fill=self.line_color, outline="")

            # Glow on latest point
            lx, ly = pts[-2], pts[-1]
            self.create_oval(lx - 4, ly - 4, lx + 4, ly + 4, fill=self.line_color, outline="#ffffff", width=1)

            # Current Live Value Tag (Top Right)
            latest_val = current_vals[-1]
            self.create_text(
                pad_left + plot_w, 12,
                text=f"{latest_val:.1f} {self.unit}".strip(),
                fill=self.line_color,
                font=("Helvetica", 10, "bold"),
                anchor="e"
            )


